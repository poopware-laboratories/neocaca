{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(zig)",
			"Bash(zig *)",
			"Bash(tmux *)",
			"Bash(git status *)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git show *)"
		],
		"deny": [
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Bash(git push origin main *)"
		]
	}
}
